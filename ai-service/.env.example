# SocialFlow AI Service - Environment Variables
# Copy this file to .env and fill in your API keys

# TEXT GENERATION PROVIDERS
# ========================

# Groq API Key (get from https://console.groq.com/)
# Free tier: $25-50 credits per month - EXCELLENT FOR TEXT
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (get from https://openrouter.ai/)
# Fallback provider for text generation
# Has free models like Qwen 3.6 Plus (100% free, $0 cost)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# IMAGE GENERATION PROVIDERS
# ==========================

# PRIMARY: Pixazo API Key (get from https://api-console.pixazo.ai/)
#  100% FREE Stable Diffusion (SD 3.5, 3, XL, XL Lightning, 1.5)
# No payment required - just get API key and start generating!
PIXAZO_API_KEY=your_pixazo_api_key_here

# FALLBACK: OpenRouter Image API (paid, used only if Pixazo fails)
# Stable Diffusion 3 Large via OpenRouter (~$0.10 per image)
# Already configured above under TEXT GENERATION PROVIDERS

# DATABASE CONFIGURATION
# =======================

# PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=socialflow
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# FEATURE FLAGS
# =============

# Use FREE embedding model by default (nvidia/llama-nemotron-embed-vl-1b-v2)
# Set to true to use free model, false to require explicit model specification
ENABLE_FALLBACK=false

# Logging level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO
